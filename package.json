{
  "name": "acetylcholine",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Acetylcholine — a pop-up dictionary browser extension for language learners, with a unified .ace dictionary format and converters.",
  "license": "MIT",
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --filter '*' build",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "ace": "bun run apps/cli/src/main.ts",
    "ext:dev": "bun run --filter @acetylcholine/extension dev",
    "ext:dev:firefox": "bun run --filter @acetylcholine/extension dev:firefox",
    "ext:build": "bun run --filter @acetylcholine/extension build",
    "ext:build:firefox": "bun run --filter @acetylcholine/extension build:firefox"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/bun": "^1.4.2",
    "@types/node": "^24.0.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22",
    "bun": ">=1.2"
  }
}
